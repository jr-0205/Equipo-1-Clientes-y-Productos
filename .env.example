# Equipo 1 - Clientes y Productos
# Copia este archivo como .env antes de ejecutar: Copy-Item .env.example .env
#
# Puertos PUBLICADOS en la computadora anfitriona (lado izquierdo de "publicado:interno").
# Los valores 2501 y 2502 son el acuerdo entre los tres equipos: NO los cambies salvo
# que otro servicio ya ocupe ese puerto en esta PC (avisa a los otros equipos si lo haces).

CLIENTES_HOST_PORT=2501
PRODUCTOS_HOST_PORT=2502

# La IP de esta computadora no se configura aqui: los otros equipos la obtienen
# con "ipconfig" y la registran en SU propio archivo .env.
# Ejemplo de lo que deben escribir ellos:
#   CLIENTES_URL=http://IP-DE-ESTA-PC:2501
#   PRODUCTOS_URL=http://IP-DE-ESTA-PC:2502
